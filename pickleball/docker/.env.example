# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pickleball_db
DB_USER=root
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password

# Ports
BACKEND_PORT=8081
FRONTEND_PORT=80
AI_SERVICE_PORT=8090
QUIZ_SERVICE_PORT=8091
MYSQL_PORT=3307

# URL Configuration (Internal Docker Network)
BACKEND_URL_INTERNAL=http://backend:8080
AI_SERVICE_URL_INTERNAL=http://aivision:8000
FRONTEND_URL_INTERNAL=http://frontend:80

# URL Configuration (Public/Browser Access)
BACKEND_URL_PUBLIC=http://localhost:${BACKEND_PORT}
FRONTEND_URL_PUBLIC=http://localhost:${FRONTEND_PORT}
AI_SERVICE_URL_PUBLIC=http://localhost:${AI_SERVICE_PORT}
VITE_AI_SERVICE_URL=http://localhost:${AI_SERVICE_PORT}

# Application Secrets
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret
EMAIL=your_email@gmail.com
APP_PASSWORD=your_app_password
OPENROUTER_API_KEY=your_openrouter_key
GEMINI_API_KEY=your_gemini_key

# Payment (VNPay)
Vnp_TmnCode=your_vnp_tmn_code
Vnp_HashSecret=your_vnp_hash_secret
Vnp_Url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Return_url=${BACKEND_URL_PUBLIC}/api/vnpay/payment_return

# Legacy/Duplicated Variable Support
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}
Frontend_url=${FRONTEND_URL_PUBLIC}
AI_SERVICE_URL=${AI_SERVICE_URL_INTERNAL}
